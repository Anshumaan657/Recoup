# Database
# SQLite file path (created automatically by Prisma in Phase 2)
DATABASE_URL="file:./dev.db"

# Application
# Public URL used for Payment Link callbacks and absolute links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay (Test Mode Only)
# Get these from Razorpay Dashboard -> Settings -> API Keys (Test Mode)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook secret from Razorpay Dashboard -> Webhooks (set after deploying webhook endpoint)
RAZORPAY_WEBHOOK_SECRET=""

# AI / LLM (Optional in DEMO_MODE)
# OpenAI-compatible endpoint (e.g., https://api.openai.com/v1 or local proxy)
AI_BASE_URL="https://api.openai.com/v1"
# API key for the LLM provider
AI_API_KEY=""
# Model to use for recovery decisions (e.g., gpt-4o-mini)
AI_MODEL="gpt-4o-mini"

# Recovery Policy
# Seconds to wait after payment.failed before evaluating recovery (late capture window)
RECOVERY_GRACE_SECONDS="90"
# Maximum recovery attempts per case
MAX_RECOVERY_ATTEMPTS="1"
# Cases at or above this amount require manual approval (₹5,000 by default)
APPROVAL_THRESHOLD_PAISE="500000"
# Set to true to enable real Razorpay Payment Link creation (requires valid credentials)
# In DEMO_MODE, missing credentials or false uses deterministic simulated links
ENABLE_RAZORPAY_LINKS="false"

# Demo / Evaluation
# When true: enables /api/demo/replay, simulated links, seeded dataset
# When false: production-like behavior, requires real credentials
DEMO_MODE="true"
# Read-only deterministic API adapter for serverless previews without durable SQLite.
# Keep false locally and in any deployment backed by a production database.
HOSTED_DEMO_MODE="false"

# Notes:
# - All money actions are TEST MODE ONLY. No live charges occur.
# - In DEMO_MODE=true, AI_API_KEY, RAZORPAY_KEY_ID/SECRET are optional (fallbacks used).
# - ENABLE_RAZORPAY_LINKS=false forces simulated links in DEMO_MODE.
# - ENABLE_RAZORPAY_LINKS=true plus credentials calls Razorpay test-mode APIs.
# - RAZORPAY_WEBHOOK_SECRET is required for production webhook verification.
