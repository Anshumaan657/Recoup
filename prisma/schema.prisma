generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model RecoveryCase {
  id                String   @id @default(cuid())
  originalPaymentId String   @unique @map("original_payment_id")
  orderId           String   @map("order_id")
  amount            Int
  currency          String   @default("INR")
  customerName      String?  @map("customer_name")
  customerEmail     String?  @map("customer_email")
  customerContact   String?  @map("customer_contact")
  paymentMethod     String?  @map("payment_method")
  failureCode       String?  @map("failure_code")
  failureReason     String?  @map("failure_reason")
  failureSource     String?  @map("failure_source")
  failureStep       String?  @map("failure_step")
  attemptCount      Int      @default(0) @map("attempt_count")
  status            String   @default("waiting")
  selectedAction    String?  @map("selected_action")
  decisionReason    String?  @map("decision_reason")
  confidence        Float?
  requiresApproval  Boolean  @default(false) @map("requires_approval")
  graceExpiresAt    DateTime? @map("grace_expires_at")
  paymentLinkId     String?  @map("payment_link_id")
  paymentLinkUrl    String?  @map("payment_link_url")
  paymentLinkExpiry DateTime? @map("payment_link_expiry")
  recoveredAmount   Int?     @map("recovered_amount")
  recoveredAt       DateTime? @map("recovered_at")
  stoppedReason     String?  @map("stopped_reason")
  demoRunId         String?  @map("demo_run_id")
  isSynthetic       Boolean  @default(false) @map("is_synthetic")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  auditEvents       AuditEvent[]
  notifications     NotificationOutbox[]
  demoRun           DemoRun? @relation(fields: [demoRunId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
  @@index([originalPaymentId])
  @@index([orderId])
  @@index([demoRunId])
  @@map("recovery_cases")
}

model DemoRun {
  id              String    @id
  datasetVersion  String    @map("dataset_version")
  seed            Int
  status          String    @default("running")
  synthetic       Boolean   @default(true)
  expectedMetrics String?   @map("expected_metrics")
  resultMetrics   String?   @map("result_metrics")
  startedAt       DateTime  @default(now()) @map("started_at")
  completedAt     DateTime? @map("completed_at")

  recoveryCases   RecoveryCase[]
  webhookReceipts WebhookReceipt[]

  @@unique([datasetVersion, seed])
  @@index([status])
  @@index([startedAt])
  @@map("demo_runs")
}

model AuditEvent {
  id              String   @id @default(cuid())
  recoveryCaseId  String   @map("recovery_case_id")
  eventType       String   @map("event_type")
  message         String
  metadata        String
  createdAt       DateTime @default(now()) @map("created_at")

  recoveryCase    RecoveryCase @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)

  @@index([recoveryCaseId])
  @@index([eventType])
  @@index([createdAt])
  @@map("audit_events")
}

model WebhookReceipt {
  id            String   @id @default(cuid())
  eventKey      String   @unique @map("event_key")
  providerEvent String   @map("provider_event")
  payloadHash   String   @map("payload_hash")
  processedAt   DateTime @default(now()) @map("processed_at")
  outcome       String
  demoRunId     String?  @map("demo_run_id")

  demoRun       DemoRun? @relation(fields: [demoRunId], references: [id], onDelete: Cascade)

  @@index([eventKey])
  @@index([providerEvent])
  @@index([processedAt])
  @@index([demoRunId])
  @@map("webhook_receipts")
}

model NotificationOutbox {
  id                String   @id @default(cuid())
  recoveryCaseId    String   @unique @map("recovery_case_id")
  channel           String
  recipient         String
  message           String
  status            String   @default("pending")
  providerReference String?  @map("provider_reference")
  sentAt            DateTime? @map("sent_at")
  createdAt         DateTime @default(now()) @map("created_at")

  recoveryCase      RecoveryCase @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
  @@map("notification_outbox")
}
