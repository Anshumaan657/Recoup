{
  "name": "recoup",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/setup-test-db.ts && vitest run",
    "test:watch": "tsx tests/setup-test-db.ts && vitest",
    "test:coverage": "tsx tests/setup-test-db.ts && vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:setup": "tsx scripts/setup-database.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "demo:replay": "tsx scripts/replay-demo.ts",
    "demo:reset": "tsx scripts/reset-demo.ts"
  },
  "dependencies": {
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "@prisma/client": "^5.20.0",
    "openai": "^4.67.1",
    "lucide-react": "^0.447.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "tailwindcss": "^3.4.14",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20",
    "vitest": "^2.1.2",
    "@vitest/coverage-v8": "^2.1.2",
    "@testing-library/react": "^16.0.1",
    "@testing-library/jest-dom": "^6.5.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.47.2",
    "@playwright/test": "^1.47.2",
    "@vitejs/plugin-react": "^4.3.2",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1"
  },
  "engines": {
    "node": "20.x"
  }
}
